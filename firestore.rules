rules_version = '2';

// قواعد أمان Firestore لتطبيق ZadGo — تمنح كل دور (عميل/سائق/مدير مطعم/مدير
// عام) الصلاحيات التي يحتاجها فعلياً في التطبيق فقط، بدلاً من ترك القاعدة
// مفتوحة بالكامل (وضع الاختبار الافتراضي) أو معتمدة على تكوين يدوي غير
// موثّق في المستودع.
//
// ملاحظة مهمة: التطبيق لا يستخدم Cloud Functions، فهذه القواعد هي خط الدفاع
// الوحيد أمام الكتابة المباشرة على Firestore (عبر REST API أو نسخة معدّلة من
// التطبيق). لذلك لا تكتفي بمنع الوصول لبيانات الآخرين، بل تُجمّد أيضاً
// الحقول المالية (رصيد المحفظة، عمولة التطبيق، أجرة السائق، حالة السداد)
// فلا يعدّلها إلا المدير العام.
//
// ما تبقّى بلا تغطية كاملة ويحتاج منطقاً على الخادم لاحقاً (المسار د/Blaze):
//   • قيم الطلب المالية لحظة الإنشاء تأتي من تطبيق العميل؛ حقول الخصم
//     والكوبون صارت مفحوصة هنا (couponGrantsDiscount)، لكن إعادة حساب
//     السعر الكامل (الأصناف والأجرة) تتطلّب خادماً.
//   • رصيد السائق يُعدَّل من جهازه (قيد العُهدة وأجرة التوصيل) — النوع
//     مقيّد بحركات التوصيل فقط، لكن مطابقة المبلغ بقيمة الطلب تحتاج خادماً.
//   • walletUsed على الطلب يُكتب من العميل؛ خصم المحفظة الفعلي محكوم بقاعدة
//     «الإنقاص فقط» على users، لكن تطابق القيمتين يحتاج خادماً.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(currentUid())).data;
    }

    function hasRole(role) {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(currentUid())) &&
          userData().role == role;
    }

    /// صفة المدير بمسارين — الادّعاء الموقّع أولاً، ثم حقل الدور القديم.
    ///
    /// `auth.token.admin` توقّعه Firebase داخل رمز الهوية ولا يزوّره عميل
    /// مهما عدّل الحزمة، ويُمنح من ورشة «Admin claim» بمفتاح الخادم لا من
    /// أي شاشة. وفحصه مجاني — بخلاف hasRole التي تدفع قراءة get() في كل
    /// تقييم قاعدة إدارية. القراءة بـget(key, default) لا بالوصول المباشر:
    /// المفتاح الغائب في token خطأُ تقييم يرفض الطلب كله لا false.
    ///
    /// مسار الدور باقٍ مؤقتاً كي لا يُقفَل المدير القائم قبل منحه الادّعاء
    /// — يُحذف بدفعة لاحقة بعد أن يؤكد المالك أن list في الورشة يظهر حسابه
    /// وأن اللوحة تعمل. (غنيمة فحص taxi-taiba الثاني، 2026-08-18)
    function hasAdminClaim() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function isAdmin() {
      return hasAdminClaim() || hasRole('admin');
    }

    // موظف الدعم (roles-design، دفعة 2026-08-20): دورٌ يفتح جزءاً من
    // اللوحة لا كلها — قراءة الطلبات والكباتن وبيانات التواصل، وإدارة
    // الشكاوى نصاً وحالةً. **كل ما يمسّ مالاً أو صلاحية يبقى للمدير**:
    // المحافظ، الصرف، العمولات، الإعدادات، الأكواد، الاعتماد، البثّ.
    function isSupport() {
      return hasRole('support');
    }

    function isDriver() {
      return hasRole('driver');
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isRestaurantManagerOf(restaurantId) {
      return hasRole('restaurantManager') && userData().restaurantId == restaurantId;
    }

    /// الحقول التي تغيّرت فعلياً في هذا التحديث — أساس كل قيود الحقول أدناه.
    /// استُخدم فحص "الحقول المتأثّرة" بدل مقارنة القيم مباشرةً لأنه يتعامل
    /// بشكل صحيح مع الحقول الغائبة في المستندات القديمة (إضافة الحقل تُعدّ
    /// تغييراً فتُرفض)، بدل أن يفشل التقييم عند قراءة حقل غير موجود.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /// حقول الطلب التي تحدّد المال: قيمة الأصناف، وأجرة السائق، وحصّة
    /// التطبيق، وعمولته، وحالة السداد، وهوية أطراف الطلب. لا يجوز لأي طرف
    /// غير المدير العام تعديلها بعد إنشاء الطلب.
    function orderMoneyKeys() {
      // restaurantCompensation: تعويض المطعم عن إلغاء بعد التحضير — مبلغ
      // مالي يقيّده المدير وحده (بند د١: كل حقل مالي جديد يُحمى فور
      // إضافته)، وإلا سكّه عميلٌ معدَّل البرمجية لصالح مطعمٍ يواطئه.
      // restaurantChargeback: خصمُ شكوى جودة على المطعم لصالح العميل —
      // مبلغ مالي يختمه المدير وحده (بند د١)، وإلا مسحه مطعمٌ معدَّل
      // البرمجية عن نفسه أو سكّه عميلٌ على مطعمٍ يخاصمه.
      // driverTip: إكرامية الكابتن — يكتبها العميل مرة عند الإنشاء ثم
      // تتجمد: كابتن معدَّل البرمجية يرفع إكراميته بنفسه لولا هذا (د١).
      // walletRefundPending: علم «ردّ رصيد الإلغاء الذاتي» — يقود صرفاً
      // إدارياً حقيقياً، فرفعه الحرّ احتيال (عميل يرفعه على طلب مُسلَّم
      // فيصرفه المدير). محمي هنا، مع استثناء دقيق في فرع العميل لكتابة
      // الإلغاء الذاتي المشروعة وحدها.
      return ['items', 'driverShare', 'appShare', 'platformCommission',
              'isPaid', 'customerId', 'restaurantId', 'orderNumber',
              'restaurantCompensation', 'restaurantChargeback', 'driverTip',
              'commissionPercent', 'walletRefundPending'];
    }

    /// هل يمنح الكوبون خصماً بهذا المبلغ الآن؟ يُفحص لحظة إنشاء الطلب:
    /// الكود موجود وفعّال وغير منتهٍ، والمبلغ لا يتجاوز سقفه (قيمة الكوبون
    /// الثابت، وسقف maxDiscount حين يكون مضبوطاً). كوبون نسبة بلا سقف لا
    /// يمكن التحقق من مبلغه هنا (يتطلّب جمع الأصناف على الخادم) — لذا
    /// يُنصح بضبط maxDiscount لكل كوبونات النسبة.
    ///
    /// كل حقل يُقرأ بقيمة افتراضية عبر get(key, default) لا بالوصول المباشر:
    /// قراءة حقل غير موجود في القواعد **خطأ تقييم** يرفض الطلب كله — فكوبون
    /// أُنشئ من لوحة الويب بلا maxDiscount مثلاً كان سيمنع العميل من إتمام
    /// طلبه أصلاً (لا مجرد رفض الخصم). ولوحة الويب طرف كاتب ثانٍ لا نضمن
    /// تطابق حقوله، فالتساهل مع الحقل الغائب شرط تشغيلي لا تجميل.
    /// والكود المحذوف يعطي isActive الافتراضية false فيُرفض بنظافة.
    function couponGrantsDiscount(code, amount) {
      let path = /databases/$(database)/documents/coupons/$(code);
      let c = exists(path) ? get(path).data : {};
      // حدّ «مرة واحدة لكل عميل» يُفرض هنا لا في التطبيق وحده (فحص مساعد
      // الويب، البند F): نسخةٌ معدَّلة كانت تعيد استخدام الكود حتى سقفه
      // العام متجاوزةً حدّ الفرد. معرّف مستند الاستخدام: `كود_معرّفالعميل`
      // (نفس صيغة _usageId في التطبيق). perUserLimit صفر = بلا حدّ فردي.
      let usagePath = /databases/$(database)/documents/coupon_usages/$(code + '_' + currentUid());
      let used = exists(usagePath) ? get(usagePath).data.get('count', 0) : 0;
      return c.get('isActive', false) == true &&
          (c.get('perUserLimit', 0) <= 0 ||
              used < c.get('perUserLimit', 0)) &&
          (c.get('expiresAt', null) == null ||
              request.time < c.get('expiresAt', null)) &&
          // الثابت مسقوف بقيمته، والنسبة مسقوفة بـ maxDiscount **الإلزامي**:
          // كوبون نسبة بلا سقف لا يمكن التحقق من مبلغه هنا (يتطلّب جمع الأصناف
          // على الخادم)، وكان يقبل أي discountAmount — فيسكّ عميلٌ معدَّل خصماً
          // 99999 يجعل payableTotal سالباً (المنصّة تدفع له). الآن كوبون النسبة
          // بلا maxDiscount موجب لا يمنح خصماً إطلاقاً — لكل نسبة سقفٌ صريح.
          (c.get('type', 'percentage') == 'fixed'
              ? amount <= c.get('value', 0)
              : (c.get('maxDiscount', 0) > 0 &&
                  amount <= c.get('maxDiscount', 0)));
    }

    /// هل نسبة العمولة المختومة على الطلب مقبولة لهذا المطعم؟ تُقبل قيمتان:
    /// **الفعّالة** (صفر في فترة إعفاء `commissionFreeUntil` ثم المضبوطة) أو
    /// **الاسمية** (المضبوطة دائماً). السماحان معاً مقصودان (مراجعة
    /// 2026-08-15): التطبيق يحسب الفعّالة بساعة الجهاز والقاعدة بساعة
    /// الخادم — تطابقٌ حرفي واحد كان يرفض طلباً شرعياً عند حدود فترة
    /// الإعفاء (انحراف ساعات) وعند النسخ القديمة التي تختم الاسمية —
    /// **بعد شحن البطاقة**. وقبول الاسمية في فترة الإعفاء لا يضرّ: من يختم
    /// نسبةً أعلى من الفعّالة يظلم نفسه لصالح المنصّة لا العكس، والعميل
    /// المعدَّل ما زال ممنوعاً من ادّعاء صفرٍ بعد انتهاء الإعفاء.
    /// تغيير النسبة أو التاريخ من اللوحة **بيانات** لا يمسّ هذه القاعدة.
    function commissionAccepted(restaurantId, claimed) {
      let r = get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
      let until = r.get('commissionFreeUntil', null);
      let nominal = r.get('commissionPercent', 15);
      let free = until != null && request.time < until;
      return claimed == nominal || (free && claimed == 0);
    }

    /// هل يمنح كودُ التسجيل هذا الدورَ لهذا المستخدم؟
    ///
    /// حارس تصعيد الصلاحية: كانت قاعدة إنشاء المستخدم تفحص الرصيد ولا
    /// تفحص الدور إطلاقاً، و`isAdmin()` تقرأ الدور من المستند نفسه الذي
    /// يكتبه المستخدم — فمن أنشأ حساباً بالبريد (والتسجيل مفتوح على مستوى
    /// Firebase) كتب `role: admin` في مستنده فصار مديراً عاماً على كل
    /// شيء. ومنعُ `admin` وحده لا يكفي: من يدّعي `restaurantManager`
    /// بمعرّف مطعم قائم ينال طلباته وقائمته.
    ///
    /// الدور المميَّز يُمنح بكود تسجيل مختوم باسم صاحبه — والختم يقع في
    /// نفس معاملة استهلاك الكود، فلا يُنتحل كودُ غيره.
    function codeGrantsRole(userId, data) {
      let code = data.get('registrationCode', '');
      let path = /databases/$(database)/documents/registrationCodes/$(code);
      let c = exists(path) ? get(path).data : {};
      return code != '' &&
          c.get('usedByUid', '') == userId &&
          c.get('role', '') == data.role &&
          // كود مطعم لا يفتح مطعماً آخر.
          (data.role != 'restaurantManager' ||
              c.get('restaurantId', '') == data.get('restaurantId', ''));
    }

    // ---------------------------------------------------------------------
    // users — كل مستخدم يرى ويعدّل بياناته فقط؛ المدير العام يرى الجميع.
    // إنشاء المستند مسموح فقط لصاحب الـ uid نفسه (تسجيل ذاتي)، ولا يمكن لأي
    // مستخدم غير المدير العام تغيير دوره الخاص (role) أو حالة تفعيله
    // (isActive) بعد الإنشاء لمنع تصعيد الصلاحيات ذاتياً.
    //
    // رصيد المحفظة (walletBalance) محمي كذلك: لا يزيده إلا المدير العام عند
    // حلّ شكوى باسترداد. لولا هذا القيد لأمكن لأي مستخدم ضبط رصيده على أي
    // مبلغ عبر تحديث مستنده مباشرةً — فالتطبيق لا يستخدم Cloud Functions،
    // وهذه القواعد هي خط الدفاع الوحيد أمام الكتابة المباشرة.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // الدعم يقرأ مستند مستخدمٍ بعينه (بيانات تواصل لشكوى بين يديه)
      // ولا يسرد القائمة كلها — get لا list: وظيفته الاتصال لا الحصر.
      allow get: if isSignedIn() &&
          (currentUid() == userId || isAdmin() || isSupport());
      allow list: if isAdmin();
      // الإنشاء الذاتي يبدأ برصيد صفر إلزاماً، فلا يُنشئ أحد حسابه برصيد
      // جاهز. والدور: `customer` متاح للجميع، وما سواه بكود تسجيل مختوم
      // باسم المُنشئ — وإلا صنع أي أحد لنفسه حساب «مدير عام».
      allow create: if isSignedIn() &&
          (!('walletBalance' in request.resource.data) ||
              request.resource.data.walletBalance == 0) &&
          (
            isAdmin() ||
            (currentUid() == userId && (
                request.resource.data.role == 'customer' ||
                codeGrantsRole(userId, request.resource.data)
            ))
          );
      allow update: if isSignedIn() && (
            isAdmin() ||
            // restaurantId ضمن المحميّة: دالّة `isRestaurantManagerOf` كلها
            // مبنية على تطابق `userData().restaurantId` مع معرّف المطعم، فلو
            // ترك حرّاً غيّره مدير مطعمٍ واحد إلى مطعم منافس فاستولى على
            // منيوه وأسعاره وطلباته وتسوياته المالية — تصعيدٌ أفقي من مطعم
            // إلى كل المطاعم. الدور مثبَّت لكن معرّف المطعم كان ثغرته.
            (currentUid() == userId &&
                !changedKeys().hasAny(['role', 'isActive', 'restaurantId']) &&
                // الرصيد: يجوز لصاحبه **إنقاصه** فقط (الدفع من محفظته عند
                // الطلب)، ولا يجوز له زيادته إطلاقاً — الزيادة استرداد أو
                // تسوية من المدير وحده. بلا هذا التمييز كان الدفع بالمحفظة
                // سيُرفض تماماً، أو كان فتحُه سيسمح بشحن الرصيد ذاتياً.
                (!changedKeys().hasAny(['walletBalance']) ||
                    request.resource.data.walletBalance <
                        resource.data.walletBalance))
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // restaurants + التصنيفات/الأصناف الفرعية — تصفّح عام حتى بدون تسجيل
    // دخول (التسجيل المؤجل: الزائر يستعرض المطاعم والأصناف قبل إنشاء حساب،
    // ولا يُطلب تسجيل الدخول إلا عند تأكيد الطلب فعلياً)، والتعديل يبقى
    // مقصوراً على المدير العام أو مدير المطعم صاحب المطعم نفسه.
    // ---------------------------------------------------------------------
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // العميل يحدّث تقييم المطعم بعد استلام طلبه — مقصور على حقلَي
      // rating/ratingCount فقط، تماماً كتقييم السائق، فلا يستطيع تعديل
      // الأسعار أو الاسم أو حالة الفتح من تطبيق العميل.
      // مدير المطعم يعدّل كل شيء عدا نسبة عمولته (العمولة المرنة): هي
      // شرط تعاقدي يضبطه المدير العام وحده — وإلا صفّر مطعمٌ عمولته بيده.
      // قيد «تقييم واحد» (غنيمة من قواعد taxi-taiba، 2026-08-16): العدّاد
      // يزيد ١ بالضبط، والمجموع (المتوسط×العدد) يتحرك ضمن نجمة 0-5 واحدة
      // — قبلها كان عميلٌ يكتب rating=5,‏ ratingCount=10000 بضربة واحدة
      // فيزيّف سمعة مطعم أو ينسفها. الهامش نسبي (0.06×مجموع العدّادين) لأن التطبيق يخزّن المتوسط مقرَّباً
      // لخانة عشرية — هامش ثابت كان سيرفض تقييمات شرعية مع نمو العدّاد.
      allow update: if isAdmin() ||
          (isRestaurantManagerOf(restaurantId) &&
              !changedKeys().hasAny(['commissionPercent'])) ||
          (isCustomer() && changedKeys().hasOnly(['rating', 'ratingCount']) &&
              request.resource.data.get('rating', 0) >= 0 &&
              request.resource.data.get('rating', 0) <= 5 &&
              request.resource.data.get('ratingCount', 0) ==
                  resource.data.get('ratingCount', 0) + 1 &&
              (request.resource.data.get('rating', 0) *
                      request.resource.data.get('ratingCount', 0)) -
                  (resource.data.get('rating', 0) *
                      resource.data.get('ratingCount', 0)) >=
                  0 - 0.06 * (request.resource.data.get('ratingCount', 0) +
                      resource.data.get('ratingCount', 0)) &&
              (request.resource.data.get('rating', 0) *
                      request.resource.data.get('ratingCount', 0)) -
                  (resource.data.get('rating', 0) *
                      resource.data.get('ratingCount', 0)) <=
                  5 + 0.06 * (request.resource.data.get('ratingCount', 0) +
                      resource.data.get('ratingCount', 0)));

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin() || isRestaurantManagerOf(restaurantId);
      }

      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || isRestaurantManagerOf(restaurantId);
      }
    }

    // ---------------------------------------------------------------------
    // orders — يراها ويعدّلها فقط أطراف الطلب (العميل صاحبه، السائق المُسنَد
    // إليه، مدير المطعم صاحب الطلب) أو المدير العام. الإنشاء مقصور على
    // العميل نفسه بصفته customerId.
    // ---------------------------------------------------------------------
    match /orders/{orderId} {
      // الدعم قارئٌ للطلبات (المتابعة الحية والسجلّ وسياق الشكوى) —
      // قراءةً فقط: لا تعديل حالة ولا إسناد ولا مال؛ التحويل يمسّ
      // العُهد والدفاتر فيبقى للمدير.
      allow get: if isSignedIn() && (
            isAdmin() || isSupport() ||
            resource.data.customerId == currentUid() ||
            resource.data.driverId == currentUid() ||
            isRestaurantManagerOf(resource.data.restaurantId)
          );
      allow list: if isSignedIn() && (
            isAdmin() || isSupport() ||
            resource.data.customerId == currentUid() ||
            resource.data.driverId == currentUid() ||
            isRestaurantManagerOf(resource.data.restaurantId)
          );
      // الإنشاء يفحص حقول الخصم لا يقبلها حرفياً: كانت القيود المالية كلها
      // على «التعديل» فقط، فعميل معدَّل البرمجية يُنشئ طلباً بخصم مختلَق
      // (discountAmount بلا كوبون أصلاً) ويتجاوز نظام الكوبونات من أساسه.
      // الخصم الموجب يستلزم كوداً موجوداً وفعّالاً وغير منتهٍ، وبسقف
      // الكوبون نفسه (قيمة الثابت، وسقف maxDiscount إن ضُبط).
      // الدفع بالبطاقة موثَّق من الخادم (د٣-أ): أي طلب يحمل paymentId
      // يشترط ختم verify.php في verified_payments — بنفس المعرّف وباسم
      // نفس المستخدم. عميل معدَّل يدّعي isPaid بمعرّف مختلَق يُرفض هنا.
      // الطلبات النقدية/المحفظة (paymentId فارغ) لا تمرّ بهذا الشرط.
      allow create: if isCustomer() &&
          request.resource.data.customerId == currentUid() &&
          (request.resource.data.get('paymentId', '') == '' ||
              (exists(/databases/$(database)/documents/verified_payments/$(request.resource.data.paymentId)) &&
               get(/databases/$(database)/documents/verified_payments/$(request.resource.data.paymentId)).data.get('uid', '') == currentUid())) &&
          // «مدفوع» عند الإنشاء يستلزم سنداً (فحص مساعد الويب، البند C):
          // ختم بطاقة موثَّق أو دفعاً من المحفظة. الطلب النقدي الخالص يبدأ
          // غير مدفوع حتماً — نسخةٌ معدَّلة كانت تنشئه isPaid:true فتوهم
          // التقارير والمطعم بتحصيلٍ لم يقع.
          (request.resource.data.get('paymentId', '') != '' ||
              request.resource.data.walletUsed > 0 ||
              request.resource.data.get('isPaid', false) == false) &&
          request.resource.data.discountAmount is number &&
          request.resource.data.walletUsed is number &&
          request.resource.data.walletUsed >= 0 &&
          request.resource.data.get('driverTip', 0) is number &&
          request.resource.data.get('driverTip', 0) >= 0 &&
          (!('commissionPercent' in request.resource.data) ||
              commissionAccepted(request.resource.data.restaurantId,
                  request.resource.data.commissionPercent)) &&
          (request.resource.data.discountAmount == 0 ||
            (request.resource.data.discountAmount > 0 &&
             request.resource.data.couponCode is string &&
             request.resource.data.couponCode != '' &&
             couponGrantsDiscount(request.resource.data.couponCode,
                 request.resource.data.discountAmount)));
      // بعد الإنشاء، لا يعدّل أحدٌ الحقول المالية (قيمة الأصناف، أجرة السائق،
      // حصّة التطبيق، حالة السداد...) إلا المدير العام — باستثناء واحد مقصود:
      // السائق المُسنَد يضبط isPaid و platformCommission لحظة تأكيد التوصيل،
      // فتلك خطوة إغلاق الطلب في تدفّق التطبيق الحالي.
      //
      // بدون هذا القيد كان بإمكان العميل تحديث طلبه وضبط isPaid على true بلا
      // دفع، أو تصفير عمولة التطبيق وأجرة السائق.
      allow update: if isSignedIn() && (
            isAdmin() ||
            // فرع العميل، وله استثناء واحد دقيق: كتابة الإلغاء الذاتي التي
            // ترفع علم ردّ الرصيد — بشكلها الحرفي فقط (من حالةٍ يجوز
            // إلغاؤها، إلى cancelled، وللطلب رصيد محفظة مستخدم فعلاً).
            // أي شكل آخر يرفع العلم يُرفض — فلا يُصرف ردٌّ لغير مستحقه.
            (resource.data.customerId == currentUid() &&
                (!changedKeys().hasAny(orderMoneyKeys()) ||
                    (changedKeys().hasOnly(['status', 'updatedAt',
                            'statusChangedAt', 'walletRefundPending']) &&
                        request.resource.data.walletRefundPending == true &&
                        request.resource.data.status == 'cancelled' &&
                        resource.data.status in ['created',
                            'restaurantPending', 'restaurantAccepted'] &&
                        resource.data.get('walletUsed', 0) > 0))) ||
            // السائق المُسنَد يكتب isPaid وplatformCommission وحدهما من
            // الحقول المالية (عند التسليم markOrderDelivered)، فقائمته =
            // orderMoneyKeys() ناقص هذين. كانت تنقصها restaurantCompensation
            // وrestaurantChargeback وcommissionPercent، فسائقٌ معدَّل على
            // طلبه المُسنَد كان يصفّر تعويض المطعم أو يخفّض عمولة المنصّة (د١).
            (resource.data.driverId == currentUid() &&
                !changedKeys().hasAny(['items', 'driverShare', 'appShare',
                                       'customerId', 'restaurantId',
                                       'orderNumber', 'driverTip',
                                       'restaurantCompensation',
                                       'restaurantChargeback',
                                       'commissionPercent'])) ||
            // طلب بلا سائق مُسنَد: السائق يقبله لنفسه (تصميم مقصود)، أو —
            // بعد رفضه إياه — يمرّره جهازُه تلقائياً لأقرب سائق آخر
            // (driverId لغيره). كان الشرط يُلزم أن يكون المعرّف الجديد هو
            // الكاتب نفسه، فتنجح إعادة الإسناد فقط حين تعود للرافض ذاته
            // وتُرفض حين تذهب لغيره — عكس المطلوب تماماً. الاستيلاء على طلب
            // مُسنَد لغيره ما زال ممنوعاً (الشرط driverId == null)، والإسناد
            // لغيره صار مجرد «عرض» يملك صاحبه رفضه (driverAcknowledged).
            (resource.data.driverId == null && isDriver() &&
                !changedKeys().hasAny(orderMoneyKeys())) ||
            (isRestaurantManagerOf(resource.data.restaurantId) &&
                !changedKeys().hasAny(orderMoneyKeys()))
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // drivers — جلب مستند سائق واحد لأي مسجَّل (تتبّع الطلب عند العميل)،
    // أما **سرد** القائمة فمقصور على من يحتاجه فعلاً: المدير (التقارير
    // والمتابعة)، والمطعم والسائق (الإسناد التلقائي لأقرب متاح). فُصل
    // get عن list تمهيداً لتفعيل المصادقة المجهولة لصفحة /join: بدون
    // الفصل كان رمز مجهول واحد يكفي لسرد أسماء الكباتن وجوالاتهم
    // وإحداثياتهم الحية وأرباحهم من سطر أوامر — والعميل لا يسرد
    // السائقين في أي شاشة أصلاً فلا ينكسر شيء.
    //
    // الكتابة كانت مفتوحة لأي سائق على مستند أي سائق آخر (isDriver() وحدها)،
    // ما يعني أن سائقاً واحداً كان بإمكانه تعديل أرباح زميله ومستحقّاته
    // (pendingPayout/totalEarnings). القيد الآن:
    //   • السائق: مستنده هو فقط.
    //   • غير العميل (سائق/مدير مطعم): مستند سائق آخر بحقل isAvailable وحده —
    //     وهو ما يتطلّبه الإسناد التلقائي عند قبول المطعم للطلب أو عند رفض
    //     سائق لطلبه فيُعاد إسناده لأقرب سائق متاح.
    //   • العميل: rating/ratingCount فقط عند تقييم السائق بعد التوصيل.
    //   • المدير العام: بلا قيد (إعادة التوزيع وصرف المستحقّات).
    // ---------------------------------------------------------------------
    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isSupport() || isDriver() ||
          hasRole('restaurantManager');
      // إنشاء مستند السائق: يبدأ بأرصدة صفرية إلزاماً. بلا هذا القيد كان
      // سائقٌ مقبول (يملك كوداً) يُنشئ مستنده مباشرةً بـ balance/totalEarnings
      // مختلَقين بدل المرور بمسار التطبيق — مسارٌ بديل للسرقة يعمل حتى لو
      // أُحكمت قاعدة التحديث. الرصيد ينمو لاحقاً بحركات دفتر لكلٍّ سببها.
      allow create: if isSignedIn() && currentUid() == driverId &&
          request.resource.data.get('balance', 0) == 0 &&
          request.resource.data.get('totalEarnings', 0) == 0 &&
          request.resource.data.get('warningCount', 0) == 0;
      // كتابة السائق على مستنده مقيّدة: كانت بلا قيد على الحقول، فيمكنه
      // ضبط إنذاراته صفراً أو تضخيم totalEarnings. الرصيد يبقى مسموحاً له
      // لأن قيد العُهدة وأجرة التوصيل يُكتبان من جهازه (لا Cloud Functions
      // بعد) — يُشدَّد لاحقاً مع المسار د.
      allow update: if isSignedIn() && (
            isAdmin() ||
            // referredByCode/referralRewarded ضمن المحميّة: الأول يُثبَّت
            // لحظة التسجيل فلا تُدّعى إحالة بأثر رجعي، والثاني ختمُ الصرف
            // فلا يُعاد تصفيره لقبض المكافأة مرتين.
            (isDriver() && currentUid() == driverId &&
                !changedKeys().hasAny(
                    ['warningCount', 'totalEarnings', 'rating', 'ratingCount',
                     'referredByCode', 'referralRewarded',
                     'lastChallengeWindow'])) ||
            // قلب توفّر السائق: يفعله جهازُ المطعم أثناء الإسناد التلقائي
            // (لا خادم بعد)، والسائق نفسه، والمدير. كان الشرط `!isCustomer()`
            // يسمح به لأي مصادَقٍ بلا دور «عميل» — بمن فيهم المصادَق مجهولاً
            // من صفحة الانضمام — فيعطّل منافساً أو يدفعه لطلبات وهو غير جاهز.
            // حصرناه بالأدوار الثلاثة الفعلية فأُغلق باب المجهول دون كسر الإسناد.
            ((isDriver() || isAdmin() || hasRole('restaurantManager')) &&
                changedKeys().hasOnly(['isAvailable'])) ||
            // قيد «تقييم واحد» — نفس غنيمة قاعدة المطاعم أعلاه (توثيقها
            // هناك): عدّاد +١ بالضبط ومجموعٌ ضمن نجمة واحدة.
            (isCustomer() && changedKeys().hasOnly(['rating', 'ratingCount']) &&
                request.resource.data.get('rating', 0) >= 0 &&
                request.resource.data.get('rating', 0) <= 5 &&
                request.resource.data.get('ratingCount', 0) ==
                    resource.data.get('ratingCount', 0) + 1 &&
                (request.resource.data.get('rating', 0) *
                        request.resource.data.get('ratingCount', 0)) -
                    (resource.data.get('rating', 0) *
                        resource.data.get('ratingCount', 0)) >=
                    0 - 0.06 * (request.resource.data.get('ratingCount', 0) +
                        resource.data.get('ratingCount', 0)) &&
                (request.resource.data.get('rating', 0) *
                        request.resource.data.get('ratingCount', 0)) -
                    (resource.data.get('rating', 0) *
                        resource.data.get('ratingCount', 0)) <=
                    5 + 0.06 * (request.resource.data.get('ratingCount', 0) +
                        resource.data.get('ratingCount', 0)))
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // driver_transactions — دفتر حساب السائق: حركة لكل تغيّر في رصيده
    // (توصيل/إيداع/صرف/تسوية). سجلّ محاسبي، لذا:
    //   • القراءة: السائق صاحب الحركة والمدير العام فقط.
    //   • الإنشاء: المدير (إيداع/صرف/تسوية)، أو السائق على حركاته هو وحدها
    //     (تُكتب تلقائياً لحظة تأكيد التوصيل من تطبيقه).
    //   • التعديل والحذف: ممنوعان تماماً حتى على المدير — السجلّ المحاسبي
    //     لا يُعدَّل بأثر رجعي، والتصحيح يكون بحركة «تسوية» جديدة تبقى ظاهرة.
    // ---------------------------------------------------------------------
    match /driver_transactions/{transactionId} {
      allow get, list: if isSignedIn() && (
            isAdmin() || resource.data.driverId == currentUid()
          );
      // السائق يُنشئ حركات تدفّق التوصيل فقط (عُهدة/عكسها/أجرة): كان الإنشاء
      // بلا قيد على النوع، فيمكنه سكّ حركة «مكافأة» باسمه توثّق رصيداً
      // زوّره على مستنده. المكافآت والإيداع والصرف والتسوية للمدير وحده.
      allow create: if isSignedIn() && (
            isAdmin() ||
            (isDriver() && request.resource.data.driverId == currentUid() &&
                request.resource.data.type in
                    ['orderCustody', 'custodyReversal',
                     'deliveryCash', 'deliveryOnline'])
          );
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // wallet_transactions — دفتر محفظة العميل: حركة لكل تغيّر في رصيده
    // (استرداد/دفع طلب/تسوية).
    //   • القراءة: صاحب المحفظة والمدير العام.
    //   • الإنشاء: المدير (استرداد/تسوية)، أو العميل على حركاته هو وحدها
    //     (تُكتب لحظة استخدام رصيده في دفع طلب).
    //   • التعديل والحذف ممنوعان حتى على المدير — سجلّ محاسبي لا يُعدَّل
    //     بأثر رجعي، والتصحيح بحركة تسوية جديدة تبقى ظاهرة.
    //
    // ملاحظة: حماية الرصيد نفسه في قاعدة users (walletBalance لا يعدّله إلا
    // المدير) لا تكفي وحدها لأن العميل يحتاج خصم رصيده عند الدفع؛ الخصم يتم
    // ضمن معاملة تتحقّق من كفاية الرصيد، ويبقى مقيّداً في هذا الدفتر.
    // ---------------------------------------------------------------------
    match /wallet_transactions/{transactionId} {
      allow get, list: if isSignedIn() && (
            isAdmin() || resource.data.userId == currentUid()
          );
      allow create: if isSignedIn() && (
            isAdmin() || request.resource.data.userId == currentUid()
          );
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // complaints — الشكوى يقدّمها أي طرف في الطلب (عميل/سائق/مدير مطعم)
    // بصفته submittedByUid. يقرؤها: مقدّمها، والمشكوّ في حقه، وعميل الطلب،
    // ومدير المطعم المعني، والمدير العام. حلّها وتحديث حالتها للمدير وحده.
    //
    // كانت القاعدة القديمة تفترض أن العميل وحده يشتكي (isCustomer +
    // customerId)، بينما التطبيق يتيح الشكوى للسائق والمطعم أيضاً — فكان
    // إرسالهما سيُرفض. كما كان السرد (list) للمدير وحده، فشاشة «شكاواي»
    // (استعلام المستخدم عن شكاواه هو) كانت سترفض حتى لصاحبها.
    // ---------------------------------------------------------------------
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && (
            isAdmin() || isSupport() ||
            resource.data.customerId == currentUid() ||
            resource.data.submittedByUid == currentUid() ||
            resource.data.againstUid == currentUid() ||
            isRestaurantManagerOf(resource.data.restaurantId)
          );
      // السرد مسموح فقط باستعلامات تضمن أن كل النتائج تخص المستخدم نفسه
      // (شكاواه المقدَّمة أو المقدَّمة عليه، أو شكاوى مطعمه لمديره) — محرّك
      // القواعد يرفض أي استعلام قد يُرجع شكوى غيره.
      allow list: if isSignedIn() && (
            isAdmin() || isSupport() ||
            resource.data.submittedByUid == currentUid() ||
            resource.data.againstUid == currentUid() ||
            isRestaurantManagerOf(resource.data.restaurantId)
          );
      allow create: if isSignedIn() &&
          request.resource.data.submittedByUid == currentUid();
      // دورة حياة الشكوى (2026-08-16): لمقدّمها وحده، ومن حالة «محلولة»
      // حصراً، تحوّلان اثنان لا ثالث لهما — «نعم حُلّت» (إغلاق) أو «لا
      // لم تُحل» (إرجاع موسوم بالارتداد). hasOnly تمنع مسّ أي حقل آخر
      // (القرار، الأطراف، النوع...) تحت غطاء التأكيد.
      allow update: if isAdmin() ||
          // الدعم يدير دورة الشكوى نصاً وحالةً حصراً — hasOnly تسدّ
          // الباب على مسّ الأطراف أو النوع أو أي حقلٍ ماليٍّ مقترح تحت
          // غطاء «تغيير الحالة». الاسترداد نفسه كتابة محفظة في users
          // وممنوع عنه هناك أصلاً — «يقترحه ولا يختمه».
          (isSupport() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'resolvedAt', 'reopenedBySubmitter',
                        'adminNote', 'resolution'])) || (
            isSignedIn() &&
            resource.data.submittedByUid == currentUid() &&
            resource.data.status == 'resolved' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'reopenedBySubmitter']) && (
              request.resource.data.status == 'closed' ||
              (request.resource.data.status == 'inProgress' &&
               request.resource.data.reopenedBySubmitter == true)
            )
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // complaint_messages — دردشة الشكوى بين مقدّمها والإدارة. البنية نفسها
    // بنية chat_messages لكن حقل orderId يحمل معرّف الشكوى.
    //
    // لم يكن لهذه المجموعة أي قواعد إطلاقاً، فكانت مرفوضة بالكامل (الرفض
    // الافتراضي) — حتى دردشة المدير نفسها من شاشة تفاصيل الشكوى.
    // ---------------------------------------------------------------------
    match /complaint_messages/{messageId} {
      function relatedComplaint() {
        return get(/databases/$(database)/documents/complaints/$(resource.data.orderId)).data;
      }
      function relatedComplaintFromRequest() {
        return get(/databases/$(database)/documents/complaints/$(request.resource.data.orderId)).data;
      }

      allow get, list: if isSignedIn() && (
            isAdmin() || isSupport() ||
            relatedComplaint().submittedByUid == currentUid()
          );
      allow create: if isSignedIn() &&
          request.resource.data.senderId == currentUid() && (
            isAdmin() || isSupport() ||
            relatedComplaintFromRequest().submittedByUid == currentUid()
          );
    }

    // ---------------------------------------------------------------------
    // chat_messages — محادثة الطلب بين العميل والسائق فقط (بالإضافة للمدير
    // العام للمراجعة عند الحاجة).
    // ---------------------------------------------------------------------
    match /chat_messages/{messageId} {
      function relatedOrder() {
        return get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data;
      }
      function relatedOrderFromRequest() {
        return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;
      }

      allow get: if isSignedIn() && (
            isAdmin() || isSupport() ||
            relatedOrder().customerId == currentUid() ||
            relatedOrder().driverId == currentUid()
          );
      allow list: if isSignedIn() && (
            isAdmin() || isSupport() ||
            relatedOrder().customerId == currentUid() ||
            relatedOrder().driverId == currentUid()
          );
      allow create: if isSignedIn() && request.resource.data.senderId == currentUid() && (
            relatedOrderFromRequest().customerId == currentUid() ||
            relatedOrderFromRequest().driverId == currentUid()
          );
    }

    // ---------------------------------------------------------------------
    // order_proofs — وثيقة إثبات الطلب: أزمنة وإحداثيات وصول السائق
    // واستلامه وتسليمه + صورتا الاستلام والتسليم (مضغوطتان داخل المستند).
    //   • الكتابة: السائق صاحب الوثيقة (driverId == uid) — يكتبها تدريجياً
    //     بدمج (merge) عند كل محطة — والمدير العام.
    //   • القراءة: المدير (شاشة حسم الشكاوى) والسائق صاحبها.
    //   • الحذف: ممنوع — وثيقة نزاع لا تُمحى.
    // ---------------------------------------------------------------------
    match /order_proofs/{orderId} {
      allow get, list: if isSignedIn() && (
            isAdmin() || resource.data.driverId == currentUid()
          );
      allow create: if isSignedIn() && (
            isAdmin() || request.resource.data.driverId == currentUid()
          );
      allow update: if isSignedIn() && (
            isAdmin() ||
            (resource.data.driverId == currentUid() &&
                request.resource.data.driverId == currentUid())
          );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // reassignments — سجل تدقيق لإعادة توزيع السائقين، للمدير العام فقط.
    // ---------------------------------------------------------------------
    match /reassignments/{reassignmentId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // delivery_settings — مستند إعدادات (delivery_settings/config) يضبط مُهل
    // Timeout لمعالجة الطلبات العالقة، يُقرأ من شاشة متابعة الطلبات في لوحة
    // المدير ويُعدَّل يدوياً من Firestore مباشرة، لذا القراءة والكتابة
    // مقصورتان على المدير العام فقط.
    // ---------------------------------------------------------------------
    // ---------------------------------------------------------------------
    // driver_applications — طلبات انضمام الكباتن من صفحة /join على الموقع.
    //
    // الإنشاء يتطلّب تسجيل دخول (المصادقة المجهولة تكفي — الصفحة تسجّل
    // المتقدّم مجهولاً قبل الإرسال): كان مفتوحاً بلا مصادقة فيغرق أحدهم
    // المجموعة بآلاف الطلبات من سطر أوامر وليس في القاعدة ما يحدّه.
    // الطلب يُختم بـuid منشئه (أساس ربط صور المستندات به)، ويُنشأ
    // «معلّقاً» بلا كود صادر — فلا يُنشئ أحد طلباً «مقبولاً» أو يمنح
    // نفسه كوداً. القراءة والمراجعة والحذف للمدير وحده: المستندات هوية
    // وإقامة، ولا يجوز سردها لأحد سواه.
    // ---------------------------------------------------------------------
    match /driver_applications/{applicationId} {
      // المتقدّم يقرأ طلبه هو (شاشة «بانتظار الاعتماد» داخل تطبيق الكابتن
      // تبثّه لحظياً) — get لا list: سرد المجموعة بكل هوياتها للمدير وحده.
      allow get: if isAdmin() ||
          (isSignedIn() && resource.data.get('uid', '') == currentUid());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
          request.resource.data.get('uid', '') == currentUid() &&
          request.resource.data.status == 'pending' &&
          request.resource.data.get('issuedCode', '') == '' &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 2;
      // المتقدّم يعدّل طلبه ما دام معلّقاً (ربط معرّفات المستندات بعد
      // رفعها)، ويعيد فتح المرفوض «معلّقاً» (إعادة تقديم بعد معالجة سبب
      // الرفض — نفس المستند فلا تتراكم نسخ أمام المدير). لا يبلغ حالةً
      // سوى pending، ولا يمنح نفسه كوداً، ولا يمسّ طلب غيره.
      allow update: if isAdmin() ||
          (isSignedIn() &&
              resource.data.get('uid', '') == currentUid() &&
              request.resource.data.get('uid', '') == currentUid() &&
              resource.data.get('status', '') in ['pending', 'rejected'] &&
              request.resource.data.status == 'pending' &&
              request.resource.data.get('issuedCode', '') == '');
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // driver_application_docs — صور مستندات المتقدّمين (هوية/رخصة/استمارة/
    // صور مركبة) مضغوطة داخل المستند (Blob) — نمط order_proofs نفسه، لكن
    // في مجموعة منفصلة لأن الطلب الواحد قد يحمل ١١ صورة (~1.65م.ب) وسقف
    // مستند Firestore ١ ميبي.
    //
    //   • الإنشاء: صاحب طلبٍ معلّق فقط، وبصورة ≤ 400ك — ضِعف هدف الضغط
    //     (150ك) وهامش، ويحدّ كلفة أي إغراق. الربط بطلب يملكه المتصل
    //     يمنع أي مسجَّل (وعملاؤنا بالآلاف) من الكتابة هنا بلا حدّ.
    //   • بعد بتّ المدير في الطلب لا تُلحق به صور — الشرط pending.
    //   • القراءة للمدير وحده، ولا تعديل ولا حذف: وثائق هوية.
    // ---------------------------------------------------------------------
    function ownsPendingApplication(appId) {
      let path = /databases/$(database)/documents/driver_applications/$(appId);
      return appId != '' && exists(path) &&
          get(path).data.get('uid', '') == currentUid() &&
          get(path).data.get('status', '') == 'pending';
    }

    match /driver_application_docs/{docId} {
      allow create: if isSignedIn() &&
          request.resource.data.get('image', null) is bytes &&
          request.resource.data.image.size() < 400000 &&
          ownsPendingApplication(request.resource.data.get('applicationId', ''));
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // restaurant_applications — طلبات انضمام المطاعم من داخل تطبيق المطعم:
    // صاحب المطعم ينشئ حساباً ويملأ بياناته ويرفع مستنداته (سجل تجاري أو
    // وثيقة عمل حر، هوية المالك...) ثم ينتظر اعتماد المدير الذي يربطه
    // بمطعمٍ ويمنحه دوره — نفس عقد طلبات الكباتن أعلاه حرفاً بحرف.
    // ---------------------------------------------------------------------
    match /restaurant_applications/{applicationId} {
      allow get: if isAdmin() ||
          (isSignedIn() && resource.data.get('uid', '') == currentUid());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
          request.resource.data.get('uid', '') == currentUid() &&
          request.resource.data.status == 'pending' &&
          request.resource.data.restaurantName is string &&
          request.resource.data.restaurantName.size() > 2;
      allow update: if isAdmin() ||
          (isSignedIn() &&
              resource.data.get('uid', '') == currentUid() &&
              request.resource.data.get('uid', '') == currentUid() &&
              resource.data.get('status', '') in ['pending', 'rejected'] &&
              request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    function ownsPendingRestaurantApplication(appId) {
      let path = /databases/$(database)/documents/restaurant_applications/$(appId);
      return appId != '' && exists(path) &&
          get(path).data.get('uid', '') == currentUid() &&
          get(path).data.get('status', '') == 'pending';
    }

    match /restaurant_application_docs/{docId} {
      allow create: if isSignedIn() &&
          request.resource.data.get('image', null) is bytes &&
          request.resource.data.image.size() < 400000 &&
          ownsPendingRestaurantApplication(request.resource.data.get('applicationId', ''));
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /delivery_settings/{settingId} {
      // ثلاث درجات قراءة مقصودة:
      //
      // • `app` (بوابة الحدّ الأدنى للإصدار): **مفتوح للجميع بلا تسجيل
      //   دخول**. تطبيق العميل يسمح بالتصفّح كزائر، ولو اشترطنا التسجيل
      //   لفشلت قراءة الزائر — والبوابة مبنيّة على «الفشل مفتوح»، فتمرّ
      //   كل نسخة قديمة عند كل غير مسجَّل. تُبنى البوابة وتبدو سليمة ولا
      //   تحجب أحداً أبداً. لا سرّ في رقم إصدار على أي حال.
      // • `incentives`: لأي مسجَّل — الكابتن يرى مبالغ الحوافز الحقيقية.
      // • الباقي (مُهل الطلبات): للمدير وحده.
      //
      // والكتابة للمدير في الحالات كلها.
      allow read: if settingId == 'app' ||
          isAdmin() ||
          (settingId == 'incentives' && isSignedIn());
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // admin_secrets — أسرار تشغيلية تخص لوحة الإدارة وحدها (أولها مفتاح
    // شريك إعلانات zol، دفعة الإعلانات 2026-08-16). للمدير حصراً قراءةً
    // وكتابةً: السر يُلصق مرة من اللوحة ويقرؤه جهاز المدير عند التوليد —
    // لا يدخل كود التطبيق أبداً (يُستخرج من أي APK) ولا يراه غير المدير.
    // ---------------------------------------------------------------------
    match /admin_secrets/{secretId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // server_reports — تقارير الذراع الخادمية (أولها فحص الأسعار اليومي،
    // دفعة الذراع ١ — 2026-08-16). يكتبها حساب الخدمة وحده (يتجاوز
    // القواعد بطبيعته) — فكتابة العملاء ممنوعة كلياً: تقريرٌ يستطيع
    // عميلٌ تلفيقه يساوي لا تقرير. القراءة للمدير حصراً.
    // ---------------------------------------------------------------------
    match /server_reports/{reportId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // admin_audit — سجلّ عمليات الإدارة. تكتبه لوحة الويب (٣١ موضع كتابة
    // على فرع main) ولم تكن له كتلة قواعد إطلاقاً، والافتراضي في Firestore
    // هو المنع — فكانت كل عملية إدارية تظنّ نفسها مسجَّلة وهي مرفوضة صامتة.
    //
    // سجلّ تدقيق لا يُعدَّل ولا يُحذف حتى من المدير: قيمته كلها في أنه لا
    // يُنقَّح بأثر رجعي. التصحيح يكون بقيد جديد يبقى الأول ظاهراً معه.
    // ---------------------------------------------------------------------
    // ---------------------------------------------------------------------
    // verified_payments — أختام التحقق من دفعات ميسر، يكتبها verify.php
    // بحساب الخدمة حصراً (يتجاوز القواعد). لا كتابة لأي عميل إطلاقاً —
    // ختمٌ يكتبه العميل يساوي لا ختم. القراءة get للمالك وللمدير.
    // ---------------------------------------------------------------------
    match /verified_payments/{paymentId} {
      allow get: if isSignedIn() &&
          (isAdmin() || resource.data.get('uid', '') == currentUid());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /admin_audit/{entryId} {
      allow get, list: if isAdmin();
      // النسبة مختومة: القيد يُنسب لكاتبه الفعلي حصراً — سجلٌّ يستطيع
      // مديرٌ نسب قيوده فيه لمدير آخر لا يُثبت شيئاً، وهو المعنى الوحيد
      // الذي مُنع لأجله التعديل والحذف. القراءة بـget الافتراضي (لا
      // وصول مباشر): حقل غائب في القواعد خطأ تقييم يُسقط الطلب كله لا
      // شرطاً يعود بـfalse — درس خطأ الكوبون.
      allow create: if (isAdmin() || isSupport()) &&
          request.resource.data.get('by', '') == currentUid();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // restaurant_requests — «اطلب مطعمك» (ح5): بحثُ عميلٍ خائب يتحول
    // لعدّاد باسم المطعم. القراءة والحذف للمدير وحده (خريطة مبيعاته)؛
    // أي مسجَّل يُنشئ بعدّاد ١ أو يزيد +1 حصراً دون مسّ الاسم — نمط
    // عدّاد الكوبون نفسه، فلا يُصفّر أحدٌ طلبات مطعمٍ منافس ولا يضخّمها
    // إلا ضغطةً ضغطة (وسقف الإزعاج محدود بطبيعته: مستند لكل اسم).
    // ---------------------------------------------------------------------
    match /restaurant_requests/{slug} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() &&
          request.resource.data.get('name', '') != '' &&
          request.resource.data.get('count', 0) == 1;
      allow update: if isAdmin() || (
            isSignedIn() &&
            request.resource.data.get('count', 0) ==
                resource.data.get('count', 0) + 1 &&
            request.resource.data.get('name', '') ==
                resource.data.get('name', '')
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // banners — البنرات الترويجية أعلى شاشة مطاعم العميل. القراءة عامة حتى
    // بدون تسجيل دخول (كالمطاعم — الزائر يتصفح قبل إنشاء حساب)، والكتابة
    // للمدير العام وحده.
    // ---------------------------------------------------------------------
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // restaurant_settlements — دفعات التسوية المسلَّمة للمطاعم. يقرؤها
    // المدير ومدير المطعم المعني (ليتابع ما استلمه مقابل مستحقّاته)،
    // ويكتبها المدير وحده. الحذف والتعديل ممنوعان — سجلّ مالي لا يُعدَّل
    // بأثر رجعي، والتصحيح بدفعة جديدة تبقى ظاهرة.
    // ---------------------------------------------------------------------
    match /restaurant_settlements/{settlementId} {
      allow get, list: if isSignedIn() && (
            isAdmin() || isRestaurantManagerOf(resource.data.restaurantId)
          );
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // coupons — أكواد الخصم (معرّف المستند = الكود نفسه). العميل يقرأ
    // الكود الواحد الذي يكتبه للتحقق منه، ولا يُسمح بسرد كل الأكواد إلا
    // للمدير (وإلا اكتُشفت الأكواد بالاستعراض). الإنشاء والتعديل للمدير
    // وحده، باستثناء واحد مقصود: عدّاد الاستخدام (usedCount) يزيده العميل
    // لحظة إنشاء طلبه — بزيادة مقدارها 1 فقط ودون مسّ أي حقل آخر، فلا
    // يستطيع تعطيل الكود ولا رفع قيمته ولا تصفير عدّاده.
    // ---------------------------------------------------------------------
    // هل يحقّ لهذا المستخدم إنقاص عدّاد الكود؟ (إرجاع كوبون طلب ملغى —
    // نفذ ٢): الإنقاص الحرّ يعني إعادة تعبئة أكواد مستنفدة وإعادة استخدام
    // «مرة واحدة لكل عميل» بلا حدّ. فيُقيَّد بواقعة قابلة للتحقق: سجلُّ
    // استخدام المستخدم نفسه يشير لطلبٍ **ملغى فعلاً** بهذا الكود وباسمه.
    function couponReleaseJustified(code) {
      let usage = get(/databases/$(database)/documents/coupon_usages/$(code + '_' + currentUid())).data;
      let order = get(/databases/$(database)/documents/orders/$(usage.lastOrderId)).data;
      return order.customerId == currentUid() &&
             order.couponCode == code &&
             (order.status == 'cancelled' || order.status == 'refunded');
    }

    match /coupons/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // زيادة العدّاد مشروطة بصلاحية الكود لحظتها: كانت «+1» وحدها، فيمكن
      // لأي مسجَّل استنزاف كود عمداً حتى سقفه بلا أي شراء، وتجاوُز السقف
      // بزيادات متسابقة (القاعدة لم تكن تقارن بالسقف أصلاً).
      // الحقول تُقرأ بقيم افتراضية: كوبون من لوحة الويب بلا usageLimit أو
      // بلا isActive كان سيرفع خطأ تقييم فيفشل تقييد الاستخدام صامتاً.
      allow update: if isAdmin() || (
            isSignedIn() &&
            changedKeys().hasOnly(['usedCount']) &&
            request.resource.data.usedCount == resource.data.usedCount + 1 &&
            resource.data.get('isActive', false) == true &&
            (resource.data.get('expiresAt', null) == null ||
                request.time < resource.data.get('expiresAt', null)) &&
            (resource.data.get('usageLimit', 0) <= 0 ||
                request.resource.data.usedCount <=
                    resource.data.get('usageLimit', 0))
          ) || (
            // إنقاص بمقدار ١ فقط، لا دون الصفر، وبواقعة إلغاء مثبتة.
            isSignedIn() &&
            changedKeys().hasOnly(['usedCount']) &&
            request.resource.data.usedCount == resource.data.usedCount - 1 &&
            request.resource.data.usedCount >= 0 &&
            couponReleaseJustified(code)
          );
    }

    // ---------------------------------------------------------------------
    // coupon_usages — سجلّ استخدام كل مستخدم لكل كود (معرّفه CODE_uid).
    // صاحبه يقرؤه ويكتبه (التحقق من «مرة واحدة لكل عميل» يقرأ مستنده هو)،
    // والمدير يرى الكل. الحذف ممنوع فلا يُعاد استخدام كود بحذف سجلّه.
    // ---------------------------------------------------------------------
    match /coupon_usages/{usageId} {
      allow get: if isSignedIn() && (
            isAdmin() || resource.data.userId == currentUid()
          );
      allow list: if isAdmin();
      // العدّاد لا يتحرك إلا +1 تصاعدياً: القاعدة السابقة سمحت لصاحب السجل
      // بأي كتابة — فيصفّر عدّاده ويعيد استخدام الكود متجاوزاً «مرة واحدة
      // لكل عميل». منع الحذف وحده لا يكفي حين يكون التصفير مباحاً.
      allow create: if isSignedIn() && (
            isAdmin() ||
            (request.resource.data.userId == currentUid() &&
                request.resource.data.count == 1)
          );
      allow update: if isSignedIn() && (
            isAdmin() ||
            (resource.data.userId == currentUid() &&
                request.resource.data.userId == resource.data.userId &&
                request.resource.data.count == resource.data.count + 1) ||
            // إرجاع كوبون طلب ملغى (نفذ ٢) — نفس شرط coupons أعلاه.
            (resource.data.userId == currentUid() &&
                request.resource.data.userId == resource.data.userId &&
                request.resource.data.count == resource.data.count - 1 &&
                request.resource.data.count >= 0 &&
                couponReleaseJustified(resource.data.code))
          );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // payout_requests — طلبات سحب مستحقّات السائقين. السائق يُنشئ طلبه هو
    // فقط وبحالة pending إلزاماً (لا يُنشئ طلباً «مصروفاً» جاهزاً)، ويقرأ
    // طلباته وحدها. البتّ (صرف/رفض) للمدير العام حصراً، والحذف ممنوع —
    // سجلّ مالي يبقى للمراجعة.
    // ---------------------------------------------------------------------
    match /payout_requests/{requestId} {
      allow get, list: if isSignedIn() && (
            isAdmin() || resource.data.driverId == currentUid()
          );
      // سقف السحب مربوط بالرصيد المرصود **في القاعدة** لا في الواجهة وحدها
      // (توصية فحص مساعد الويب 2026-08-15، البند B-الجزئي): كابتن معدَّل
      // كان يقدّم طلب سحب بأي مبلغ ويبقى صدُّه على انتباه المدير وحده.
      // لا يغلق سكّ الرصيد نفسه (مؤجَّل للخادم) لكنه يضيف حاجزاً ثانياً.
      allow create: if isDriver() &&
          request.resource.data.driverId == currentUid() &&
          request.resource.data.status == 'pending' &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.amount <=
              get(/databases/$(database)/documents/drivers/$(currentUid()))
                  .data.get('balance', 0);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // broadcasts — إرسال رسائل جماعية للمدير العام فقط، وقراءتها لأي مستخدم
    // مسجّل دخوله (كل من السائقين والعملاء يقرؤون الرسائل الموجّهة لهم).
    // ---------------------------------------------------------------------
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // registrationCodes — تُقرأ وثيقة واحدة (بمعرفها/الرمز) حتى بدون تسجيل
    // دخول للتحقق الأولي قبل إنشاء الحساب، لكن لا يُسمح بسرد كل الرموز إلا
    // للمدير العام (لمنع اكتشاف رموز صالحة عبر الاستعراض). الإنشاء/الحذف
    // للمدير العام فقط. التحديث مقصور على خطوتَي "استهلاك" الرمز فقط:
    // (١) وضعه كمُستخدَم (isUsed: false → true) دون تغيير أي حقل آخر غير
    // usedAt، و(٢) ربط الحساب المُستهلِك به فور ذلك (usedByUid/usedByName)
    // من صاحب الحساب نفسه فقط. أي تعديل آخر (تغيير الدور، المطعم، إلخ)
    // مرفوض تماماً لمنع انتحال الرمز أو التلاعب به بعد إنشائه.
    // ---------------------------------------------------------------------
    match /registrationCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
            isSignedIn() && (
              (resource.data.isUsed == false &&
                  // الكود المنتهي لا يُستهلك حتى بالكتابة المباشرة — فحص
                  // الصلاحية هنا لا في التطبيق وحده.
                  (!('expiresAt' in resource.data) ||
                      resource.data.expiresAt == null ||
                      request.time < resource.data.expiresAt) &&
                  request.resource.data.isUsed == true &&
                  // الختم باسم المستهلِك يقع في نفس المعاملة (النسخة
                  // الحالية)، أو في خطوة تالية (نسخ أقدم) — كلاهما مقبول
                  // أثناء انتشار التحديث، والمعرّف لا يكون لغير الكاتب.
                  (!('usedByUid' in request.resource.data.diff(resource.data).affectedKeys()) ||
                      request.resource.data.usedByUid == currentUid()) &&
                  request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['isUsed', 'usedAt', 'usedByUid', 'usedByName'])) ||
              (resource.data.isUsed == true &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByUid', 'usedByName']) &&
                  request.resource.data.usedByUid == currentUid() &&
                  (!('usedByUid' in resource.data) || resource.data.usedByUid == null ||
                      resource.data.usedByUid == currentUid()))
            )
          );
    }
  }
}
