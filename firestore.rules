rules_version = '2';

// قواعد أمان Firestore لتطبيق ZadGo — تمنح كل دور (عميل/سائق/مدير مطعم/مدير
// عام) الصلاحيات التي يحتاجها فعلياً في التطبيق فقط، بدلاً من ترك القاعدة
// مفتوحة بالكامل (وضع الاختبار الافتراضي) أو معتمدة على تكوين يدوي غير
// موثّق في المستودع.
//
// ملاحظة مهمة: التطبيق لا يستخدم Cloud Functions، فهذه القواعد هي خط الدفاع
// الوحيد أمام الكتابة المباشرة على Firestore (عبر REST API أو نسخة معدّلة من
// التطبيق). لذلك لا تكتفي بمنع الوصول لبيانات الآخرين، بل تُجمّد أيضاً
// الحقول المالية (رصيد المحفظة، عمولة التطبيق، أجرة السائق، حالة السداد)
// فلا يعدّلها إلا المدير العام.
//
// ما تبقّى بلا تغطية كاملة ويحتاج منطقاً على الخادم لاحقاً:
//   • قيم الطلب المالية لحظة الإنشاء تأتي من تطبيق العميل ولا يمكن التحقق من
//     صحتها هنا (تتطلّب إعادة حساب السعر على الخادم).
//   • السائق يزيد مستحقّاته على مستنده عند تأكيد التوصيل، فالقاعدة تسمح بذلك
//     لأن التدفّق الحالي يتطلّبه.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(currentUid())).data;
    }

    function hasRole(role) {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(currentUid())) &&
          userData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDriver() {
      return hasRole('driver');
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isRestaurantManagerOf(restaurantId) {
      return hasRole('restaurantManager') && userData().restaurantId == restaurantId;
    }

    /// الحقول التي تغيّرت فعلياً في هذا التحديث — أساس كل قيود الحقول أدناه.
    /// استُخدم فحص "الحقول المتأثّرة" بدل مقارنة القيم مباشرةً لأنه يتعامل
    /// بشكل صحيح مع الحقول الغائبة في المستندات القديمة (إضافة الحقل تُعدّ
    /// تغييراً فتُرفض)، بدل أن يفشل التقييم عند قراءة حقل غير موجود.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /// حقول الطلب التي تحدّد المال: قيمة الأصناف، وأجرة السائق، وحصّة
    /// التطبيق، وعمولته، وحالة السداد، وهوية أطراف الطلب. لا يجوز لأي طرف
    /// غير المدير العام تعديلها بعد إنشاء الطلب.
    function orderMoneyKeys() {
      return ['items', 'driverShare', 'appShare', 'platformCommission',
              'isPaid', 'customerId', 'restaurantId', 'orderNumber'];
    }

    // ---------------------------------------------------------------------
    // users — كل مستخدم يرى ويعدّل بياناته فقط؛ المدير العام يرى الجميع.
    // إنشاء المستند مسموح فقط لصاحب الـ uid نفسه (تسجيل ذاتي)، ولا يمكن لأي
    // مستخدم غير المدير العام تغيير دوره الخاص (role) أو حالة تفعيله
    // (isActive) بعد الإنشاء لمنع تصعيد الصلاحيات ذاتياً.
    //
    // رصيد المحفظة (walletBalance) محمي كذلك: لا يزيده إلا المدير العام عند
    // حلّ شكوى باسترداد. لولا هذا القيد لأمكن لأي مستخدم ضبط رصيده على أي
    // مبلغ عبر تحديث مستنده مباشرةً — فالتطبيق لا يستخدم Cloud Functions،
    // وهذه القواعد هي خط الدفاع الوحيد أمام الكتابة المباشرة.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (currentUid() == userId || isAdmin());
      allow list: if isAdmin();
      // الإنشاء الذاتي يبدأ برصيد صفر إلزاماً، فلا يُنشئ أحد حسابه برصيد جاهز.
      allow create: if isSignedIn() && currentUid() == userId &&
          (!('walletBalance' in request.resource.data) ||
              request.resource.data.walletBalance == 0);
      allow update: if isSignedIn() && (
            isAdmin() ||
            (currentUid() == userId &&
                !changedKeys().hasAny(['role', 'isActive', 'walletBalance']))
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // restaurants + التصنيفات/الأصناف الفرعية — تصفّح عام حتى بدون تسجيل
    // دخول (التسجيل المؤجل: الزائر يستعرض المطاعم والأصناف قبل إنشاء حساب،
    // ولا يُطلب تسجيل الدخول إلا عند تأكيد الطلب فعلياً)، والتعديل يبقى
    // مقصوراً على المدير العام أو مدير المطعم صاحب المطعم نفسه.
    // ---------------------------------------------------------------------
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // العميل يحدّث تقييم المطعم بعد استلام طلبه — مقصور على حقلَي
      // rating/ratingCount فقط، تماماً كتقييم السائق، فلا يستطيع تعديل
      // الأسعار أو الاسم أو حالة الفتح من تطبيق العميل.
      allow update: if isAdmin() || isRestaurantManagerOf(restaurantId) ||
          (isCustomer() && changedKeys().hasOnly(['rating', 'ratingCount']));

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin() || isRestaurantManagerOf(restaurantId);
      }

      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || isRestaurantManagerOf(restaurantId);
      }
    }

    // ---------------------------------------------------------------------
    // orders — يراها ويعدّلها فقط أطراف الطلب (العميل صاحبه، السائق المُسنَد
    // إليه، مدير المطعم صاحب الطلب) أو المدير العام. الإنشاء مقصور على
    // العميل نفسه بصفته customerId.
    // ---------------------------------------------------------------------
    match /orders/{orderId} {
      allow get: if isSignedIn() && (
            isAdmin() ||
            resource.data.customerId == currentUid() ||
            resource.data.driverId == currentUid() ||
            isRestaurantManagerOf(resource.data.restaurantId)
          );
      allow list: if isSignedIn() && (
            isAdmin() ||
            resource.data.customerId == currentUid() ||
            resource.data.driverId == currentUid() ||
            isRestaurantManagerOf(resource.data.restaurantId)
          );
      allow create: if isCustomer() && request.resource.data.customerId == currentUid();
      // بعد الإنشاء، لا يعدّل أحدٌ الحقول المالية (قيمة الأصناف، أجرة السائق،
      // حصّة التطبيق، حالة السداد...) إلا المدير العام — باستثناء واحد مقصود:
      // السائق المُسنَد يضبط isPaid و platformCommission لحظة تأكيد التوصيل،
      // فتلك خطوة إغلاق الطلب في تدفّق التطبيق الحالي.
      //
      // بدون هذا القيد كان بإمكان العميل تحديث طلبه وضبط isPaid على true بلا
      // دفع، أو تصفير عمولة التطبيق وأجرة السائق.
      allow update: if isSignedIn() && (
            isAdmin() ||
            (resource.data.customerId == currentUid() &&
                !changedKeys().hasAny(orderMoneyKeys())) ||
            (resource.data.driverId == currentUid() &&
                !changedKeys().hasAny(['items', 'driverShare', 'appShare',
                                       'customerId', 'restaurantId', 'orderNumber'])) ||
            // السائق يقبل الطلب بنفسه (تصميم مقصود)، لكن فقط إن كان الطلب
            // بلا سائق مُسنَد أصلاً — يمنع سائقاً من الاستيلاء على طلب مُسنَد
            // لغيره عبر الكتابة المباشرة على driverId.
            (resource.data.driverId == null &&
                request.resource.data.driverId == currentUid() &&
                !changedKeys().hasAny(orderMoneyKeys())) ||
            (isRestaurantManagerOf(resource.data.restaurantId) &&
                !changedKeys().hasAny(orderMoneyKeys()))
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // drivers — القراءة لأي مستخدم مسجّل دخوله (تُستخدم لعرض بيانات السائق
    // ضمن تتبّع الطلب).
    //
    // الكتابة كانت مفتوحة لأي سائق على مستند أي سائق آخر (isDriver() وحدها)،
    // ما يعني أن سائقاً واحداً كان بإمكانه تعديل أرباح زميله ومستحقّاته
    // (pendingPayout/totalEarnings). القيد الآن:
    //   • السائق: مستنده هو فقط.
    //   • غير العميل (سائق/مدير مطعم): مستند سائق آخر بحقل isAvailable وحده —
    //     وهو ما يتطلّبه الإسناد التلقائي عند قبول المطعم للطلب أو عند رفض
    //     سائق لطلبه فيُعاد إسناده لأقرب سائق متاح.
    //   • العميل: rating/ratingCount فقط عند تقييم السائق بعد التوصيل.
    //   • المدير العام: بلا قيد (إعادة التوزيع وصرف المستحقّات).
    // ---------------------------------------------------------------------
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && currentUid() == driverId;
      allow update: if isSignedIn() && (
            isAdmin() ||
            (isDriver() && currentUid() == driverId) ||
            (!isCustomer() && changedKeys().hasOnly(['isAvailable'])) ||
            (isCustomer() && changedKeys().hasOnly(['rating', 'ratingCount']))
          );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // complaints — العميل ينشئ شكوى على طلبه الخاص فقط. يراها العميل صاحبها،
    // مدير المطعم المعني، أو المدير العام. حلّها/تحديث حالتها للمدير العام.
    // ---------------------------------------------------------------------
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && (
            isAdmin() ||
            resource.data.customerId == currentUid() ||
            isRestaurantManagerOf(resource.data.restaurantId)
          );
      allow list: if isAdmin();
      allow create: if isCustomer() && request.resource.data.customerId == currentUid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // chat_messages — محادثة الطلب بين العميل والسائق فقط (بالإضافة للمدير
    // العام للمراجعة عند الحاجة).
    // ---------------------------------------------------------------------
    match /chat_messages/{messageId} {
      function relatedOrder() {
        return get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data;
      }
      function relatedOrderFromRequest() {
        return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;
      }

      allow get: if isSignedIn() && (
            isAdmin() ||
            relatedOrder().customerId == currentUid() ||
            relatedOrder().driverId == currentUid()
          );
      allow list: if isSignedIn() && (
            isAdmin() ||
            relatedOrder().customerId == currentUid() ||
            relatedOrder().driverId == currentUid()
          );
      allow create: if isSignedIn() && request.resource.data.senderId == currentUid() && (
            relatedOrderFromRequest().customerId == currentUid() ||
            relatedOrderFromRequest().driverId == currentUid()
          );
    }

    // ---------------------------------------------------------------------
    // reassignments — سجل تدقيق لإعادة توزيع السائقين، للمدير العام فقط.
    // ---------------------------------------------------------------------
    match /reassignments/{reassignmentId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // delivery_settings — مستند إعدادات (delivery_settings/config) يضبط مُهل
    // Timeout لمعالجة الطلبات العالقة، يُقرأ من شاشة متابعة الطلبات في لوحة
    // المدير ويُعدَّل يدوياً من Firestore مباشرة، لذا القراءة والكتابة
    // مقصورتان على المدير العام فقط.
    // ---------------------------------------------------------------------
    match /delivery_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // broadcasts — إرسال رسائل جماعية للمدير العام فقط، وقراءتها لأي مستخدم
    // مسجّل دخوله (كل من السائقين والعملاء يقرؤون الرسائل الموجّهة لهم).
    // ---------------------------------------------------------------------
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // registrationCodes — تُقرأ وثيقة واحدة (بمعرفها/الرمز) حتى بدون تسجيل
    // دخول للتحقق الأولي قبل إنشاء الحساب، لكن لا يُسمح بسرد كل الرموز إلا
    // للمدير العام (لمنع اكتشاف رموز صالحة عبر الاستعراض). الإنشاء/الحذف
    // للمدير العام فقط. التحديث مقصور على خطوتَي "استهلاك" الرمز فقط:
    // (١) وضعه كمُستخدَم (isUsed: false → true) دون تغيير أي حقل آخر غير
    // usedAt، و(٢) ربط الحساب المُستهلِك به فور ذلك (usedByUid/usedByName)
    // من صاحب الحساب نفسه فقط. أي تعديل آخر (تغيير الدور، المطعم، إلخ)
    // مرفوض تماماً لمنع انتحال الرمز أو التلاعب به بعد إنشائه.
    // ---------------------------------------------------------------------
    match /registrationCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
            isSignedIn() && (
              (resource.data.isUsed == false &&
                  request.resource.data.isUsed == true &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedAt'])) ||
              (resource.data.isUsed == true &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByUid', 'usedByName']) &&
                  request.resource.data.usedByUid == currentUid() &&
                  (!('usedByUid' in resource.data) || resource.data.usedByUid == null ||
                      resource.data.usedByUid == currentUid()))
            )
          );
    }
  }
}
