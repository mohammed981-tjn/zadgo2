# Release signing secrets — never commit the real keystore or credentials.
android/key.properties
*.jks
*.keystore

# إعداد الخادم المرافق الفعلي ومفاتيح حساب الخدمة — لا تُرفع أبداً.
# النسخة القابلة للرفع هي config.sample.php فقط.
server/api/config.php
service-account*.json

# تبعيات دوال Cloud Functions — تُثبَّت عند النشر لا تُرفع.
functions/node_modules/
functions/package-lock.json

# مخرجات فحص QR — تُولَّد بأمر `node tools/verify-qr.js` ولا تُرفع.
tools/verify-qr-cases.json
