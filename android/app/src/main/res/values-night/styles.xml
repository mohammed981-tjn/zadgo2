<?xml version="1.0" encoding="utf-8"?>
<!-- نسخة «ليلية» مطابقة تماماً للنهارية عمداً: ألوان التطبيق مصممة
     فاتحة ثابتة (الوضع الليلي مؤجل بقرار ج5)، وبعض واجهات الشركات
     (هواوي/أونر وغيرها) تتجاهل forceDarkAllowed وتقلب ألوان أي تطبيق
     «لا يدعم الليلي» — ووجود موارد night يقنعها أنه يدعمه فتتركه.
     شوهد ميدانياً على جهاز المالك 2026-08-14 بعد أن لم يكفِ المانيفست. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
